venv/
.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
logs/

# Model registry DB -- contains BYOK API keys (nvapi-..., gsk_..., etc), never commit.
model_testing_data/

# Ingestion artifacts (generated, not source)
chroma_db/
figures/
json/
chunks_*.json
rag_results.json
last_prompt.txt

# dbv2/ is committed on purpose: it's the pre-built vector store the deployed
# API reads from, and there's no ingestion step in the Dockerfile to rebuild
# it -- shipping it in git is what the container actually gets. Explicit
# negation needed because the generic chroma_db/ rule above would otherwise
# also match the nested dbv2/chroma_db/ directory.
!dbv2/
!dbv2/**
