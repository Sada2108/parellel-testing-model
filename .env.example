# Copy this file to .env and fill in real values. .env is gitignored;
# this template is not -- never put a real secret in this file.

# Hugging Face token -- used for embeddings (src/embed.py, via huggingface_hub)
# and the enhancement/summary model (src/ingestion/enrich.py).
HF_TOKEN=

# Gemini API key -- used by langchain-google-genai (ChatGoogleGenerativeAI) for
# answer generation in Query & Retrieve (src/retrieval/generate.py). The
# library also accepts GOOGLE_API_KEY as an alias; GEMINI_API_KEY is enough.
GEMINI_API_KEY=

# Optional -- enables LiteLLM's langsmith success callback in the Parallel
# Model Test harness (src/model_testing/harness.py), so every model call
# (including judge-model calls) shows up as an inspectable trace in
# LangSmith -- full prompt/response, tokens, cost, latency -- grouped by
# parallel-run batch. Absent = tracing simply doesn't fire; this is not a
# hard dependency for running tests. Get a key at https://smith.langchain.com
LANGSMITH_API_KEY=
